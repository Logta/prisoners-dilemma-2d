{
  "name": "prisoners-dilemma-2d-web",
  "version": "0.1.0",
  "type": "module",
  "description": "2D Prisoner's Dilemma Simulation - Web Frontend",
  "scripts": {
    "dev": "vite",
    "build": "npm run copy-wasm && tsc && vite build",
    "copy-wasm": "cp -r ../wasm/pkg/* src/assets/pkg/",
    "preview": "vite preview",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:ffix": "biome check --write --unsafe .",
    "biome:init": "biome init",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Logta/prisoners-dilemma-2d.git",
    "name": "prisoners-dilemma-2d"
  },
  "keywords": [
    "prisoners-dilemma",
    "simulation",
    "genetic-algorithm",
    "evolution",
    "react",
    "typescript",
    "webassembly",
    "rust"
  ],
  "author": "Your Name",
  "license": "MIT",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "qs": "^6.16.2"
  }
}