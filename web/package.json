{
  "name": "prisoners-dilemma-2d-web",
  "version": "0.1.0",
  "type": "module",
  "description": "2D Prisoner's Dilemma Simulation - Web Frontend",
  "scripts": {
    "dev": "vite",
    "build": "npm run copy-wasm && tsc && vite build",
    "copy-wasm": "cp -r ../wasm/pkg/* src/assets/pkg/",
    "preview": "vite preview",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:ffix": "biome check --write --unsafe .",
    "biome:init": "biome init",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.2",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Logta/prisoners-dilemma-2d.git",
    "name": "prisoners-dilemma-2d"
  },
  "keywords": [
    "prisoners-dilemma",
    "simulation",
    "genetic-algorithm",
    "evolution",
    "react",
    "typescript",
    "webassembly",
    "rust"
  ],
  "author": "Your Name",
  "license": "MIT",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}