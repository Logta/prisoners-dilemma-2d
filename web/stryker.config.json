{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "mutate": [
    "src/lib/**/*.ts",
    "src/hooks/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "checkers": [],
  "reporters": [
    "clear-text",
    "progress",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "concurrency": 4,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "tsconfigFile": "__skip_tsconfig_rewrite__.json",
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
